<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": signs Fetchly-Windows-Setup.exe.
     The GitHub artifact is a zip containing the installer at its root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Fetchly-Windows-Setup.exe" product-name="Fetchly" product-version="${version}.0">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
